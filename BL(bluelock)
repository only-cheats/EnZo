local SIGNALS = { "InputBegan", "InputEnded", "Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up" }

local function forEachConnection(obj, fn)
    if type(getconnections) ~= "function" then return end
    for _, sigName in ipairs(SIGNALS) do
        local sig
        pcall(function() sig = obj[sigName] end)
        if sig then
            local ok, conns = pcall(getconnections, sig)
            if ok and conns then
                for _, c in ipairs(conns) do fn(c, sigName) end
            end
        end
    end
end

local function fakeInput()
    return {
        UserInputType = Enum.UserInputType.MouseButton1,
        UserInputState = Enum.UserInputState.Begin,
        KeyCode = Enum.KeyCode.Unknown,
        Position = Vector3.zero,
        Delta = Vector3.zero,
    }
end

local function triggerMinimize(targets)
    for _, obj in ipairs(targets) do
        forEachConnection(obj, function(c, sigName)
            pcall(function()
                if sigName == "InputBegan" or sigName == "InputEnded" then
                    c:Fire(fakeInput(), false)
                else
                    c:Fire()
                end
            end)
        end)
    end
end

local function hookCloseToMinimize()
    if not lunaGui or type(getconnections) ~= "function" then return end
    local closeTargets = findByName(lunaGui, function(n) return n:find("close") end)
    local minTargets = findByName(lunaGui, function(n) return n:find("minim") or n == "hide" end)
    if #closeTargets == 0 or #minTargets == 0 then
        warn("[EnZo] Could not find close/minimize buttons, X keeps its default behavior.")
        return
    end
    for _, obj in ipairs(closeTargets) do
        forEachConnection(obj, function(c) pcall(function() c:Disable() end) end)
        track(obj.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                triggerMinimize(minTargets)
            end
        end))
    end
end

