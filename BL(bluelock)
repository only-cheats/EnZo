local function isEnemy(plr)
    if plr == LocalPlayer then return false end
    if LocalPlayer.Team and plr.Team and plr.Team == LocalPlayer.Team then return false end
    return true
end

local function getBallHolder(ball)
    local best, bestDist = nil, 8
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - ball.Position).Magnitude
            if d < bestDist then
                best, bestDist = plr, d
            end
        end
    end
    return best
end

local actionConn
local lastDribble, lastSteal = 0, 0

local function ensureActionLoop()
    if actionConn then return end
    actionConn = true
    task.spawn(function()
        while running and (autoDribbleActive or autoStealActive) do
            task.wait(0.1)
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local ball = hrp and getBall()
            if hrp and ball then
                local holder = getBallHolder(ball)
                local now = os.clock()

                if autoStealActive and holder and isEnemy(holder)
                    and (hrp.Position - ball.Position).Magnitude <= stealRange
                    and now - lastSteal > 0.4 then
                    lastSteal = now
                    if type(firetouchinterest) == "function" then
                        pcall(function()
                            firetouchinterest(ball, hrp, 0)
                            firetouchinterest(ball, hrp, 1)
                        end)
                    end
                    task.spawn(tapKey, STEAL_KEY)
                end

                if autoDribbleActive and holder == LocalPlayer and now - lastDribble > 0.8 then
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if isEnemy(plr) then
                            local eh = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                            if eh and (eh.Position - hrp.Position).Magnitude <= dribbleRange then
                                lastDribble = now
                                task.spawn(tapKey, DRIBBLE_KEY)
                                break
                            end
                        end
                    end
                end
            end
        end
        actionConn = nil
    end)
end

