local STAMINA_WORDS = { "stam", "energy", "endurance", "fatigue" }
local STAMINA_EXACT = { sp = true }
local STAMINA_SKIP = { "max", "drain", "cost", "regen", "rate", "cooldown", "speed", "multi", "delay", "gain", "use" }

local function isStaminaName(name)
    local n = tostring(name):lower()
    for _, bad in ipairs(STAMINA_SKIP) do
        if n:find(bad) then return false end
    end
    if STAMINA_EXACT[n] then return true end
    for _, word in ipairs(STAMINA_WORDS) do
        if n:find(word) then return true end
    end
    return false
end

local locked = {}
local lockConns = {}
local gcTables = {}
local staminaConn
local rescanThread

local function targetFor(seen, maxHint)
    return math.max(seen or 0, maxHint or 0, 100)
end

local function findMaxSibling(parent, name)
    if not parent then return nil end
    local candidates = { "Max" .. name, name .. "Max", "Max_" .. name, name .. "_Max", "MaxStamina", "StaminaMax" }
    for _, c in ipairs(candidates) do
        local obj = parent:FindFirstChild(c)
        if obj and (obj:IsA("NumberValue") or obj:IsA("IntValue")) then
            return obj.Value
        end
        local attr = parent:GetAttribute(c)
        if type(attr) == "number" then return attr end
    end
    return nil
end

local function lockValueObject(obj)
    if locked[obj] then return end
    local entry = { kind = "value", max = targetFor(obj.Value, findMaxSibling(obj.Parent, obj.Name)) }
    locked[obj] = entry
    local conn = obj:GetPropertyChangedSignal("Value"):Connect(function()
        if infStaminaActive and running and obj.Value < entry.max then
            pcall(function() obj.Value = entry.max end)
        end
    end)
    table.insert(lockConns, conn)
    pcall(function() obj.Value = entry.max end)
end

local function lockAttribute(inst, name)
    local key = inst
    locked[key] = locked[key] or {}
    if locked[key][name] then return end
    local current = inst:GetAttribute(name)
    local entry = { kind = "attr", max = targetFor(current, findMaxSibling(inst, name)) }
    locked[key][name] = entry
    local conn = inst:GetAttributeChangedSignal(name):Connect(function()
        local v = inst:GetAttribute(name)
        if infStaminaActive and running and type(v) == "number" and v < entry.max then
            pcall(function() inst:SetAttribute(name, entry.max) end)
        end
    end)
    table.insert(lockConns, conn)
    pcall(function() inst:SetAttribute(name, entry.max) end)
end

local function checkObject(obj)
    if (obj:IsA("NumberValue") or obj:IsA("IntValue")) and isStaminaName(obj.Name) then
        lockValueObject(obj)
    end
    for attrName, attrVal in pairs(obj:GetAttributes()) do
        if type(attrVal) == "number" and isStaminaName(attrName) then
            lockAttribute(obj, attrName)
        end
    end
end

local function scanInstance(root)
    if not root then return end
    checkObject(root)
    local count = 0
    for _, obj in ipairs(root:GetDescendants()) do
        checkObject(obj)
        count += 1
        if count % 250 == 0 then
            task.wait()
        end
    end
end

local gcScanned = false

local function scanGcTables()
    if type(getgc) ~= "function" then return end
    local found = {}
    local ok, objs = pcall(getgc, true)
    if not ok or type(objs) ~= "table" then return end
    local count = 0
    for _, v in ipairs(objs) do
        if type(v) == "table" then
            pcall(function()
                for key, val in next, v do
                    if type(key) == "string" and type(val) == "number" and isStaminaName(key) then
                        local entry = found[v] or {}
                        entry[key] = math.max(val, 100)
                        found[v] = entry
                    end
                end
            end)
        end
        count += 1
        if count % 2000 == 0 then
            task.wait()
        end
    end
    gcTables = found
    gcScanned = true
end

local function applyGcTables()
    for tbl, keys in next, gcTables do
        for key, maxVal in next, keys do
            local current = rawget(tbl, key)
            if type(current) == "number" and current < maxVal then
                pcall(rawset, tbl, key, maxVal)
            end
        end
    end
end

local function watchRoot(root)
    if not root then return end
    local conn = root.DescendantAdded:Connect(function(obj)
        if infStaminaActive and running then
            task.defer(checkObject, obj)
        end
    end)
    table.insert(lockConns, conn)
end

local function stopStamina()
    infStaminaActive = false
    if staminaConn then staminaConn:Disconnect(); staminaConn = nil end
    for _, c in ipairs(lockConns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(lockConns)
    table.clear(locked)
end

local function startStamina()
    infStaminaActive = true

    staminaConn = track(RunService.Heartbeat:Connect(function()
        if infStaminaActive and running then
            applyGcTables()
        end
    end))

    watchRoot(LocalPlayer.Character)
    watchRoot(LocalPlayer)

    task.spawn(function()
        scanInstance(LocalPlayer.Character)
        scanInstance(LocalPlayer)
        if not infStaminaActive then return end
        if not gcScanned then
            scanGcTables()
        end
        if not infStaminaActive then return end
        pcall(scanInstance, ReplicatedStorage)
    end)
end

