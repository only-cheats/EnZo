local function findGameButton(words)
    local cacheKey = words[1]
    local cached = buttonCache[cacheKey]
    if cached and cached.Parent then return cached end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("GuiButton") then
            local label = obj.Name:lower()
            if obj:IsA("TextButton") then label = label .. " " .. obj.Text:lower() end
            for _, w in ipairs(words) do
                if label:find(w) then
                    buttonCache[cacheKey] = obj
                    return obj
                end
            end
        end
    end
    return nil
end

local function activateButton(btn)
    local fired = false
    if type(getconnections) == "function" then
        for _, sigName in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down", "TouchTap" }) do
            local ok, conns = pcall(getconnections, btn[sigName])
            if ok and conns then
                for _, c in ipairs(conns) do
                    if pcall(function() c:Fire() end) then fired = true end
                end
            end
        end
    end
    if not fired and type(firesignal) == "function" then
        if pcall(firesignal, btn.Activated) then fired = true end
    end
    return fired
end

local function pressKey(key, down)
    if isMobile and KEY_WORDS[key] then
        if not down then return end
        local btn = findGameButton(KEY_WORDS[key])
        if btn and activateButton(btn) then return end
    end
    pcall(function()
        VirtualInputManager:SendKeyEvent(down, key, false, game)
    end)
end

local function tapKey(key)
    if isMobile and KEY_WORDS[key] then
        local btn = findGameButton(KEY_WORDS[key])
        if btn and activateButton(btn) then return end
    end
    pressKey(key, true)
    task.wait(0.05)
    pressKey(key, false)
end

