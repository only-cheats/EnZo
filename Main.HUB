-- Variable für den Spam-Status
local spamActive = false

local Toggle = Tab:CreateToggle({
	Name = "spam print",
	Description = nil,
	CurrentValue = false,
    Callback = function(Value)
        spamActive = Value
         
        if spamActive then
            task.spawn(function()
                while spamActive do
                    print("by EnZo")
                    task.task_wait = task.wait(0.5)
                end
            end)
        end
    end
}, "Toggle")

